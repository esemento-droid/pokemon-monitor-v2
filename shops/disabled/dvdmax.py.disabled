"""
Scraper: dvdmax.pl
Silnik: JS rendered
Metoda: Playwright + BeautifulSoup
Szukanie: Pokemon tcg
Wykluczenia: kubek, notaes, puzzle, pluszak, figurk, postcards
Dostępność: 'Dodaj  do koszyka' = dostępny, 'Produkt niedostępny' = niedostępny
"""
import asyncio
import re
import logging
from bs4 import BeautifulSoup

logger = logging.getLogger(__name__)
SHOP = "dvdmax.pl"
BASE_URL = "https://dvdmax.pl"
SEARCH_URL = "https://dvdmax.pl/dvd/szukaj?q=Pokemon%20tcg"
USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
EXCLUDE_KEYWORDS = ["kubek", "notaes", "notebook", "mug", "puzzle", "pluszak", "figurk", "plakat", "poster", "postcards", "trolley", "licensing"]


async def get_products():
    products = []
    try:
        from playwright.async_api import async_playwright
        async with async_playwright() as p:
            browser = await p.chromium.launch(headless=True)
            page = await browser.new_page(user_agent=USER_AGENT)
            await page.goto(SEARCH_URL, wait_until="commit", timeout=60000)
            await page.wait_for_selector("a[href*=art]", timeout=40000)
            content = await page.content()
            await browser.close()
        soup = BeautifulSoup(content, "lxml")
        items = soup.select("div.bg-white > div.flex.flex-col")
        seen = set()
        for item in items:
            txt = item.get_text(" ", strip=True)
            if not any(kw in txt.lower() for kw in ["pokemon", "pokémon"]):
                continue
            if not "tcg" in txt.lower():
                continue
            if any(kw in txt.lower() for kw in EXCLUDE_KEYWORDS):
                continue
            link = item.select_one("a[href*=art]")
            if not link:
                continue
            href = link.get("href", "")
            # PID z URL (,artXXXX)
            pid = ""
            if ",art" in href:
                pid = href.split(",art")[1]
            if not pid or pid in seen:
                continue
            seen.add(pid)
            # Nazwa z img alt lub tekstu
            img = link.select_one("img")
            name = img.get("alt", "") if img else ""
            if not name:
                name = link.get_text(" ", strip=True)[:80]
            if not name or name == "Loading...":
                # Fallback: nazwa z calego item tekstu
                ftxt = txt.split("KARTY")[0].split("ZABAWKA")[0].split("GRA")[0].strip()
                name = ftxt[:80] if ftxt else ""
            # Dostepnosc
            available = "dodaj do koszyka" in txt.lower()
            # Cena
            price = "brak"
            if "koszyka" in txt:
                parts = txt.split("koszyka")
                if len(parts) > 1:
                    m = re.search(r"(\d+)\s+(\d+)", parts[1][:30])
                    if m:
                        price = f"{m.group(1)}.{m.group(2)} PLN"
            # Obrazek
            image = img.get("src", "") if img else ""
            url = BASE_URL + href if href.startswith("/") else href
            products.append({
                "id": f"dvdmax_{pid}",
                "name": name,
                "price": price,
                "shop": SHOP,
                "url": url,
                "image": image,
                "stock": 1 if available else 0,
                "available": available,
            })
    except Exception as e:
        print(f"[dvdmax] Error: {e}")
    logger.info(f"[dvdmax] {len(products)} produktow ({sum(1 for p in products if p['available'])} avail)")
    return products

[Unit]
Description=Persistent Pokemon mobile proxy recovery supervisor
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=debian
WorkingDirectory=/opt/pokemon-monitor-v2
ExecStart=/opt/pokemon-monitor-v2/infra/proxy_recovery_daemon.sh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
